# Forest Club Urla · Cloudflare Pages güvenlik başlıkları (eski netlify.toml'un karşılığı). Ana sayfa arama motorlarına
# açık; paneller, dekont ve form sayfaları ve tasarım parçaları (sayfalar/) kapalı. Functions yanıtlarına (/e/<id>,
# /sitemap.xml) bu dosya uygulanmaz: aynı başlıklar functions/e/[id].js içinde de yazılı (test ikisini karşılaştırır).
/*
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://gflabqnazkstsyafzdmn.supabase.co wss://gflabqnazkstsyafzdmn.supabase.co https://api.open-meteo.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/uye
  X-Robots-Tag: noindex, nofollow

/uye/*
  X-Robots-Tag: noindex, nofollow

/yonetim
  X-Robots-Tag: noindex, nofollow

/yonetim/*
  X-Robots-Tag: noindex, nofollow

/dekont
  X-Robots-Tag: noindex, nofollow

/dekont/*
  X-Robots-Tag: noindex, nofollow

/form
  X-Robots-Tag: noindex, nofollow

/form/*
  X-Robots-Tag: noindex, nofollow

/sayfalar/*
  X-Robots-Tag: noindex, nofollow

# Resimler ve videolar (/_blob/): tarayıcı 7 gün saklar (çoğu dosyanın adı içeriğin özeti; birkaç sabit adlı dosya
# değişirse en geç bir haftada yenilenir)
/_blob/*
  Cache-Control: public, max-age=604800
